<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform Temp Monitor (Avalonia). net8.0-windows: LibreHardwareMonitor sensors;
       net8.0: Linux (hwmon) sensors. Linux publish: dotnet publish -f net8.0 -r linux-x64 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TempMonitor</AssemblyName>
    <RootNamespace>TempMonitor.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!-- Windows: elevated by default (CPU/RAM/drive temperatures need admin), single portable exe. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <!-- `dotnet build -p:AsInvoker=true` builds a non-elevated copy for development. -->
  <PropertyGroup Condition="'$(AsInvoker)' == 'true' and '$(TargetFramework)' == 'net8.0-windows'">
    <ApplicationManifest>app.asinvoker.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DEV_INSTANCE</DefineConstants>
  </PropertyGroup>

  <!-- Linux: one self-contained executable when published with -r linux-x64 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TempMonitor.Core\TempMonitor.Core.csproj" />
    <ProjectReference Include="..\TempMonitor.Sensors.Windows\TempMonitor.Sensors.Windows.csproj"
                      Condition="'$(TargetFramework)' == 'net8.0-windows'" />
    <ProjectReference Include="..\TempMonitor.Sensors.Linux\TempMonitor.Sensors.Linux.csproj"
                      Condition="'$(TargetFramework)' == 'net8.0'" />
    <ProjectReference Include="..\TempMonitor.History\TempMonitor.History.csproj"
                      Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>

</Project>
