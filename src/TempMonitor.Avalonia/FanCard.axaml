<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TempMonitor.App.FanCard"
             Width="320" Margin="8">
    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1" CornerRadius="10" Padding="16,14">
        <StackPanel>
            <DockPanel>
                <!-- Profile picker: only when the fan service is reachable (Linux) -->
                <ComboBox x:Name="ProfileBox" DockPanel.Dock="Right" IsVisible="False" MinWidth="120"
                          FontSize="12" Padding="8,2" VerticalAlignment="Center"
                          ToolTip.Tip="Fan profile. Auto leaves every fan to the BIOS / firmware."/>
                <TextBlock Text="Fans" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="CountText" FontSize="12" Margin="10,2,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMuted}"/>
            </DockPanel>

            <!-- One row per fan (FanRow), filled in code -->
            <StackPanel x:Name="Rows" Margin="0,2,0,0"/>

            <TextBlock x:Name="NoteText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMuted}" IsVisible="False"/>

            <Button x:Name="SafetyButton" Classes="link" Content="Safety limits…" IsVisible="False"
                    Margin="0,8,0,0" HorizontalAlignment="Left" Click="OnSafety"
                    ToolTip.Tip="Minimum fan speed and the temperatures that send every fan to full speed"/>
        </StackPanel>
    </Border>

    <UserControl.Styles>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource UsageBrush}"/>
        </Style>
        <Style Selector="Button.edit">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource UsageBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
</UserControl>
