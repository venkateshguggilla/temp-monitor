<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sensor history (SQLite) and the background monitor: records readings, downsamples them,
       and raises overheat alerts. Platform-neutral; the host supplies sensors and notifications. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TempMonitor.History</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TempMonitor.Core\TempMonitor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TempMonitor.History.Tests" />
  </ItemGroup>

</Project>
