<UserControl x:Class="TempMonitor.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" Margin="8">
    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1" CornerRadius="10" Padding="16,14">
        <StackPanel>
            <!-- Header -->
            <DockPanel>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock x:Name="DeviceText" FontSize="12" Margin="10,2,0,0"
                           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Right"/>
            </DockPanel>

            <!-- Big numbers -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TempText" FontSize="34" FontWeight="SemiBold" Text="—"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="TempLabel" FontSize="11" Foreground="{StaticResource TextMuted}"
                               TextWrapping="Wrap" Text="Temperature"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="UsageText" FontSize="34" FontWeight="SemiBold" Text="—"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="UsageLabel" FontSize="11" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Right" Text="Usage"/>
                </StackPanel>
            </Grid>

            <!-- Usage bar -->
            <Border Height="6" CornerRadius="3" Background="{StaticResource TrackBg}" Margin="0,10,0,0">
                <Border x:Name="UsageBar" CornerRadius="3" Background="{StaticResource UsageBrush}"
                        HorizontalAlignment="Left" Width="0"/>
            </Border>

            <!-- Optional secondary bar -->
            <StackPanel x:Name="SecondaryPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <DockPanel>
                    <TextBlock x:Name="SecondaryLabel" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="SecondaryText" FontSize="11" Foreground="{StaticResource TextPrimary}"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <Border Height="4" CornerRadius="2" Background="{StaticResource TrackBg}" Margin="0,4,0,0">
                    <Border x:Name="SecondaryBar" CornerRadius="2" Background="{StaticResource SecondaryBrush}"
                            HorizontalAlignment="Left" Width="0"/>
                </Border>
            </StackPanel>

            <!-- History: last 2 minutes -->
            <Grid Height="56" Margin="0,12,0,0" x:Name="ChartArea" ClipToBounds="True">
                <Polyline x:Name="UsageLine" Stroke="{StaticResource UsageBrush}" StrokeThickness="1.5"
                          Opacity="0.7" StrokeLineJoin="Round"/>
                <Polyline x:Name="TempLine" Stroke="{StaticResource WarmBrush}" StrokeThickness="2"
                          StrokeLineJoin="Round"/>
            </Grid>
            <DockPanel Margin="0,4,0,0">
                <TextBlock x:Name="LegendText" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                <TextBlock x:Name="MinMaxText" FontSize="10" Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Right"/>
            </DockPanel>

            <TextBlock x:Name="DetailsText" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
    </Border>
</UserControl>
